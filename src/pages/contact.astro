
---
const contactItems = [
  {
    number: "01",
    title: "Product Type",
    description: "T-shirts, polo shirts, hoodies, sportswear, workwear or other apparel."
  },
  {
    number: "02",
    title: "Order Quantity",
    description: "Your estimated quantity and size breakdown, if available."
  },
  {
    number: "03",
    title: "Customization Details",
    description: "Colors, fabrics, logos, printing, embroidery and design requirements."
  },
  {
    number: "04",
    title: "Target Delivery Date",
    description: "Your preferred delivery schedule and destination country."
  }
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Contact KULUS for custom teamwear, uniforms and apparel OEM and ODM projects." />
  <title>Contact Us | KULUS Custom Teamwear</title>
</head>

<body>
  <header class="header">
    <a class="logo" href="/">
      <span class="logo-main">KULUS</span>
      <span class="logo-sub">CUSTOM TEAMWEAR</span>
    </a>

    <nav>
      <a href="/">Home</a>
      <a href="/products">Products</a>
      <a href="/about">About Us</a>
      <a href="/manufacturing">Manufacturing</a>
      <a class="active" href="/contact">Contact</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <p class="eyebrow">LET'S TALK ABOUT YOUR PROJECT</p>
      <h1>Let's Create Something<br />Together.</h1>
      <p>
        Have a custom apparel project in mind? Tell us what you need.
        Our team is ready to discuss your ideas and explore suitable solutions.
      </p>
      <a class="button" href="#contact-options">GET IN TOUCH</a>
    </section>

    <section class="contact-section section" id="contact-options">
      <div class="section-heading">
        <p class="eyebrow">CONTACT KULUS</p>
        <h2>Start a Conversation</h2>
        <p>
          Contact us through WhatsApp or our Alibaba International Store
          to discuss your custom apparel requirements.
        </p>
      </div>

      <div class="contact-grid">
        <article class="contact-card">
          <div class="contact-icon">W</div>
          <h3>WhatsApp</h3>
          <p>
            Contact us directly to discuss products, customization details
            and your project requirements.
          </p>
          <a class="card-link" href="https://wa.me/8613925478127" target="_blank" rel="noopener noreferrer">
            CHAT ON WHATSAPP →
          </a>
        </article>
      </div>
    </section>

    <section class="requirements section">
      <div class="section-heading">
        <p class="eyebrow">YOUR PROJECT DETAILS</p>
        <h2>What Should You Tell Us?</h2>
        <p>
          Sharing a few details helps us understand your project
          and discuss the next steps more efficiently.
        </p>
      </div>

      <div class="requirement-list">
        {contactItems.map((item) => (
          <article class="requirement">
            <span>{item.number}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="closing">
      <p class="eyebrow">KULUS · CUSTOM APPAREL</p>
      <h2>Your Ideas. Your Team. Your Identity.</h2>
      <p>
        From custom teamwear to business uniforms, let's discuss
        an apparel solution that fits your needs.
      </p>
      <a class="button light-button" href="https://kulus.en.alibaba.com/" target="_blank" rel="noopener noreferrer">
        CONTACT KULUS
      </a>
    </section>
  </main>

  <footer>
    <a class="footer-logo" href="/">KULUS</a>
    <p>Custom Teamwear · Apparel · OEM & ODM</p>
    <p class="copyright">© {new Date().getFullYear()} KULUS. All rights reserved.</p>
  </footer>
</body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    color: #203448;
    font-family: Arial, Helvetica, sans-serif;
    background: #fff;
  }

  :global(a) {
    text-decoration: none;
  }

  .header {
    min-height: 82px;
    padding: 16px 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: white;
  }

  .logo {
    display: flex;
    flex-direction: column;
    color: #17324b;
  }

  .logo-main {
    font-size: 27px;
    font-weight: 800;
    letter-spacing: 3px;
  }

  .logo-sub {
    margin-top: 3px;
    font-size: 9px;
    letter-spacing: 2px;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
  }

  nav a {
    color: #53616d;
    font-size: 13px;
  }

  nav a:hover,
  nav a.active {
    color: #24678f;
  }

  .hero {
    padding: 105px 8%;
    color: white;
    text-align: center;
    background:
      linear-gradient(rgba(15, 39, 59, .86), rgba(15, 39, 59, .86)),
      url("/images/factory-workshop.jpg") center/cover no-repeat;
  }

  .eyebrow {
    color: #77a8c8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
  }

  .hero .eyebrow {
    color: #b9d7e9;
  }

  h1 {
    margin: 22px 0;
    font-size: clamp(38px, 6vw, 62px);
    line-height: 1.15;
  }

  .hero > p:not(.eyebrow) {
    max-width: 650px;
    margin: 0 auto;
    color: #dce6ed;
    font-size: 15px;
    line-height: 1.9;
  }

  .button {
    display: inline-block;
    margin-top: 28px;
    padding: 15px 27px;
    color: white;
    background: #24678f;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.3px;
  }

  .button:hover {
    background: #174966;
  }

  .section {
    padding: 85px 9%;
  }

  .section-heading {
    max-width: 720px;
    margin: 0 auto 42px;
    text-align: center;
  }

  .section-heading h2 {
    margin: 14px 0;
    color: #1b3449;
    font-size: clamp(28px, 4vw, 40px);
  }

  .section-heading > p:last-child {
    color: #71808c;
    font-size: 14px;
    line-height: 1.9;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
    max-width: 950px;
    margin: auto;
  }

  .contact-card {
    padding: 38px;
    border: 1px solid #e5ebef;
    background: #fff;
    text-align: center;
  }

  .contact-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 20px;
    display: grid;
    place-items: center;
    color: white;
    background: #245e80;
    border-radius: 50%;
    font-size: 19px;
    font-weight: 700;
  }

  .contact-card h3 {
    color: #20394d;
    font-size: 21px;
  }

  .contact-card p {
    min-height: 75px;
    color: #73808a;
    font-size: 13px;
    line-height: 1.9;
  }

  .card-link {
    display: inline-block;
    margin-top: 18px;
    color: #24678f;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .requirements {
    background: #f3f6f8;
  }

  .requirement-list {
    max-width: 820px;
    margin: auto;
  }

  .requirement {
    display: flex;
    gap: 25px;
    padding: 23px 0;
    border-bottom: 1px solid #dfe6eb;
  }

  .requirement > span {
    flex: 0 0 45px;
    color: #4b88ad;
    font-size: 23px;
    font-weight: 700;
  }

  .requirement h3 {
    margin: 2px 0 9px;
    color: #243c50;
    font-size: 17px;
  }

  .requirement p {
    margin: 0;
    color: #71808c;
    font-size: 13px;
    line-height: 1.8;
  }

  .closing {
    padding: 85px 8%;
    color: white;
    background: #17364f;
    text-align: center;
  }

  .closing h2 {
    margin: 18px 0;
    font-size: clamp(28px, 4vw, 40px);
  }

  .closing > p:not(.eyebrow) {
    max-width: 650px;
    margin: auto;
    color: #d0dce5;
    font-size: 14px;
    line-height: 1.9;
  }

  .light-button {
    color: #17364f;
    background: white;
  }

  .light-button:hover {
    color: white;
    background: #24678f;
  }

  footer {
    padding: 38px 20px;
    color: #c5d0d9;
    background: #102638;
    text-align: center;
    font-size: 12px;
  }

  .footer-logo {
    color: white;
    font-size: 23px;
    font-weight: 800;
    letter-spacing: 3px;
  }

  .copyright {
    margin-top: 22px;
    color: #8fa0ad;
    font-size: 11px;
  }

  @media (max-width: 760px) {
    .header {
      align-items: flex-start;
      flex-direction: column;
      padding: 18px 6%;
    }

    nav {
      gap: 14px;
    }

    nav a {
      font-size: 12px;
    }

    .hero {
      padding: 75px 7%;
    }

    .section {
      padding: 60px 7%;
    }

    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-card {
      padding: 30px 22px;
    }

    .contact-card p {
      min-height: auto;
    }

    .requirement {
      gap: 15px;
    }
  }
</style>
